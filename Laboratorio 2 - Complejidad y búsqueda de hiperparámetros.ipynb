    "})\n",
    "coef_lasso_df[\"Característica\"] = coef_lasso_df[\"Característica\"].str.split(\"__\").str[-1]\n",
    "coef_lasso_df[\"coef_lasso\"] = coef_lasso_df[\"coef_lasso\"].round(3)\n",
    "coef_lasso_df_sorted = coef_lasso_df.sort_values(\n",
