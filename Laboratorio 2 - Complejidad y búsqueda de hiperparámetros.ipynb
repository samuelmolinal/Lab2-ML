       "            style=\"position-anchor: --doc-link-positive;\">\n",
       "            positive: bool, default=False<br><br>When set to ``True``, forces the coefficients to be positive.<br>Only &#x27;lbfgs&#x27; solver is supported in this case.</span>\n",
       "        </a>\n",
       "    </td>\n",
       "            <td class=\"value\">False</td>\n",
       "        </tr>\n",
